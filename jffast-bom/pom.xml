            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-redis-template</artifactId>
                <version>1.46.0</version>
            </dependency>
            <!-- Jackson 3（Spring Boot 4 基线）下的序列化插件，替代 sa-token-jackson -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-jackson3</artifactId>
                <version>1.46.0</version>
            </dependency>
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-oauth2</artifactId>
                <version>1.46.0</version>
            </dependency>
            <!-- Knife4j 官方截至 4.5.0 未适配 Spring Boot 4（底层 springdoc 2.x 绑定 Jackson 2），
                 改用 springdoc-openapi 原生。Knife4jConfig 本就是 springdoc 原生写法，回切成本仅一个坐标。 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>3.1.1</version>
            </dependency>
            <!-- 必须用 -jakarta 构型且版本与 springdoc 3.x 传递引入的 swagger-core-jakarta 一致：
                 非 jakarta 的 swagger-annotations（旧值 2.2.28）与 jakarta 版同包名（io.swagger.v3.oas.annotations），
                 两者同时在 classpath 时旧版胜出，而 2.2.30 才加入 Schema.$dynamicRef()——
                 springdoc 3 调用即 NoSuchMethodError，症状是 /v3/api-docs 恒 500、Swagger UI 打不开接口定义。 -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>2.2.55</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>5.8.43</version>
            </dependency>
        <!-- Hutool PinyinUtil 的拼音引擎（TinyPinyin，Apache-2.0）：createDictCode 用，缺它 500（2026-10-17 实测） -->        <!-- Hutool PinyinUtil 的拼音引擎（Bopomofo4j，Apache-2.0）：「生成代号」。
             2026-10-17 实测：TinyPinyin 引擎在 hutool 5.8.43 下 getFirstLetter 对中文返回空；
             jpinyin/pinyin4j license 均含 GPL 分支，公开仓不用；Bopomofo4j 是 hutool
             5.8.40+ 官方引擎且零外部词库依赖。其默认「沙盒模式」运行期连 Maven 下载新 jar，
             框架在 SysRoleController 静态块强制 local()（离线/内网边界）。 -->
        <dependency>
            <groupId>com.rnkrsoft.bopomofo4j</groupId>
            <artifactId>bopomofo4j</artifactId>
            <version>1.0.1</version>
        </dependency>
            <dependency>
                <groupId>com.github.yitter</groupId>
                <artifactId>yitter-idgenerator</artifactId>
                <version>1.0.6</version>
            </dependency>
            <dependency>
                <groupId>cn.idev.excel</groupId>
                <artifactId>fastexcel</artifactId>
                <version>1.3.0</version>
            </dependency>
        <!-- FastExcel 1.3.0 -> POI 5.4.1 需要 commons-compress >= 1.26 的新
             `putArchiveEntry(ZipArchiveEntry)`；直接依赖（minio 等）把版本拉回 1.24.0
             时会在Excel 导出触发 NoSuchMethodError（2026-10-17 实测）。显式管理。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.27.1</version>
        </dependency>
            <!-- 安全：8.5.7 及更早受 CVE-2025-59952（CVSS 8.7 High，GHSA-h7rh-xfpj-hpcm）影响——
                 解析 S3 返回的 XML 时会把标签值里的 ${...} 替换成系统属性/环境变量的真值，
                 等价于让不可信 XML 回带 MYSQL_PASSWORD / RSA_PRIVATE_KEY 等凭据。8.6.0 起关闭该替换。
                 升级只需改坐标，官方无 API 破坏变更。 -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>8.6.0</version>
            </dependency>
            <!-- 对象存储多云 SDK（按存储类型选用） -->
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>3.18.1</version>
            </dependency>
            <dependency>
                <groupId>com.qcloud</groupId>
                <artifactId>cos_api</artifactId>
                <version>5.6.281</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>4.12.0</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot4</artifactId>
                <version>2.4.0</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>1.6.3</version>
            </dependency>
            <dependency>
                <groupId>org.dom4j</groupId>
                <artifactId>dom4j</artifactId>
                <version>2.1.4</version>
            </dependency>
            <!-- 安全：1.78 受 CVE-2025-8916（PKIXCertPathReviewer 过度资源分配，DoS，CVSS 6.3）影响，
                 官方修复版本 1.79。纯版本 bump，API 兼容。
                 2026-11-02 再升到 1.80（1.x 线当前最新）。背景与残留告警见
                 jffast/SECURITY.md「已知取舍」：bcprov 是 commons-compress（经 POI）的传递依赖，
                 本项目源码零引用，且已声明的 4 条告警（2 CRITICAL）分别涉及 X.509 证书链
                 Name Constraints 绕过、GOST 28147 CTR 密钥流复用、ASN.1 嵌套深度守卫重置、
                 LDAP 注入——jffast 不使用其中任何一条路径（自实现 RSA + Sa-Token，不做证书链
                 校验、不用 GOST、不接 LDAP），故判定为不可达。
                 1.x 线修复这些告警需 1.84/1.85，Maven Central 尚未发布；升级到 2.x 需要
                 连带改 bcpkix / bcutil 且属大版本迁移，不在 1.0.0 首发范围内。 -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>1.80</version>
            </dependency>

            <!-- ─── Flowable 工作流引擎 ─── -->
            <!-- 仅引入 process starter（BPMN 2.0）；注意它经 flowable-spring-security -->
            <!-- 传递带入 flowable-idm-engine（IdentityService 被 FlowService 注入，属实需）， -->
            <!-- 但不含 CMMN/DMN。IDM 引擎启动时同样做 schema 管理，种子版本必须同步（见 FlowableConfigTest）。 -->
            <!-- Base 版定位为轻量工作流，复杂能力（动态表单/案例管理）由 Pro 扩展 -->
            <!-- Flowable 8 是首个基于 Spring Framework 7 / Spring Boot 4 的版本，强制 Jackson 3 并收紧 ISO 8601 解析；
                 7.x 线（含 7.2.0）仍绑定 Spring Boot 3，不可与 Boot 4 混用 -->
            <dependency>
                <groupId>org.flowable</groupId>
                <artifactId>flowable-spring-boot-starter-process</artifactId>
                <version>8.0.0</version>
            </dependency>

            <!-- ─── 多数据库 JDBC 驱动版本管理 ─── -->
            <!-- MyBatis-Plus 代码层原生支持多数据库（PaginationInnerInterceptor 自动识别 DbType）， -->
            <!-- 业务项目按需在 jffast-starter-mybatis 之外引入对应驱动即可。 -->
            <!-- MySQL / PostgreSQL / Oracle 驱动版本由 Spring Boot 自带 BOM 管理，此处不再重复声明； -->
            <!-- DM / Kingbase 驱动 Spring Boot 不管理，由 jffast-bom 统一管控版本。 -->
            <!-- 注意：DM / Kingbase 驱动可能不在 Maven Central，需用户从官方获取后 install 到本地仓库或私服。 -->
            <dependency>
                <groupId>com.dameng</groupId>
                <artifactId>DmJdbcDriver18</artifactId>
                <version>8.1.3.140</version>
            </dependency>
            <dependency>
                <groupId>cn.com.kingbase</groupId>
                <artifactId>kingbase8</artifactId>
                <version>8.6.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
