            <!-- 刻意停在 3.5.16：3.5.17 将 IService/ServiceImpl 包名由 extension.service 改为 spring.service，
                 属全项目 import 迁移，与 Boot 4 升级无关，不纳入本次范围。3.5.16 已提供 spring-boot4-starter。 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>3.5.18.1</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
