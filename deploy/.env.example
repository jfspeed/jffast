# jffast 后端栈环境变量样例
#
# 用法（.env 准备已脚本化，不用再手动复制密钥）：
#   bash deploy/init.sh                    # 生成/体检 deploy/.env：RSA 密钥对、随机口令，
#                                          # 前端公钥自动同步到并列的 jffast-ui 仓
#   docker network create jffast-net       # 与前端共享的网络（只需一次）
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --build
#
# 想手工准备也可以：cp deploy/.env.example deploy/.env 后自己填必填项。
#
# 显式带 --env-file 是为了不依赖 compose 对 .env 查找路径的版本差异。
#
# 标注「必填」的项缺失时 compose 会直接拒绝启动（${VAR:?msg}），
# 而不是让容器起来后以「登录失败」「连不上库」的形态暴露问题。
#
# ⚠️ 本文件会包含私钥，填好后**不要提交进仓库**（建议把 .env 加进 .gitignore）。

# ── Spring profile ──
# dev 可省略大部分配置（内置 127.0.0.1 默认值 + 自动生成一次性 RSA 密钥对）；
# prod 会打开全部必填校验、关闭 swagger、强制初始密码外部注入。
SPRING_PROFILES_ACTIVE=prod

# ── 数据库 / Redis（与 compose 里的默认值保持一致即可）──
MYSQL_DB=jffast
# test1234 是仓库统一的公开测试填充值，仅用于本地体验；对外部署务必改成强口令
MYSQL_PASSWORD=test1234
MYSQL_HOST_PORT=3306
# prod 的 JDBC url 默认 sslMode=REQUIRED；容器间无 TLS 时用 PREFERRED 兜底
MYSQL_SSL_MODE=PREFERRED
REDIS_PASSWORD=test1234
REDIS_HOST_PORT=6379

# ── 后端镜像与端口 ──
# 想用预构建镜像（部署机不装 JDK/Maven）就改这里，compose 会跳过 build 直接用该 tag
# BACKEND_IMAGE=ghcr.io/<owner>/jffast-boot:latest
BACKEND_IMAGE=jffast-boot:latest
BACKEND_HOST_PORT=7200

# ── 与前端共享的网络（需先 docker network create jffast-net）──
JFFAST_NETWORK=jffast-net

# ── 容器名前缀（可选，默认 jffast-）──
# 同一宿主机要再跑一套同名栈时，给第二套一个唯一前缀（形如 acme-，末尾带连字符）即可并存；
# `-p <项目名>` 只改项目名（卷名/网络名），改不了编排里显式声明的 container_name。
# CONTAINER_NAME_PREFIX=acme-

# ── 必填：RSA 密钥对 ──
# 一次生成、前后端共用：bash deploy/gen-rsa.sh
# 前端那一半（公钥）要写进 jffast-ui/deploy/.env 的 VITE_RSA_PUBLIC_KEY
# （compose 经 build-arg 注入前端镜像；.env.release.local 是本地 npm 构建用的，
#  不会进镜像 —— .dockerignore 已排除 .env.*.local）。
# 两边不是同一对时，服务能启动但登录必失败。
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# ── 必填：admin 初始密码 ──
# prod profile 下无默认值（覆盖 application.yml 里公开的 test1234），缺失即启动失败
JFFAST_INIT_PASSWORD=

# ── 安全：可信反向代理网段（反代部署必配） ──
# 容器内后端看到的 TCP 对端是「前端 nginx 容器」的地址。不配本项 ⇒ 所有用户被判成
# 同一个 IP，per-IP 限流（登录 30 次/分、验证码 10 次/分）退化成全站一个桶：一个实例
# 的验证码额度（10 次/分）很容易被整站耗光，导致所有人取不到验证码而登不进去。
# 默认取 Docker 默认 bridge 段；若自定义网络不在 172.16.0.0/12 内，改成该网络 CIDR。
# 多个用逗号分隔，如 172.16.0.0/12,127.0.0.1（127.0.0.1 供本机直连/同机 nginx）。
# 留空 = 不信任任何转发头（安全默认，但反代下不可用）。
JFFAST_SECURITY_TRUSTED_PROXIES=172.16.0.0/12
