<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.jfspeed</groupId>
        <artifactId>jffast-starters</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jffast-starter-oauth2-client</artifactId>
    <name>jffast-starter-oauth2-client</name>
    <description>jffast OAuth2 Client Starter - universal OAuth2 client calling third-party services (client_credentials / authorization_code), DB-backed config + Redis token cache</description>

    <dependencies>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-log</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-reactor-netty</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
