<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.jfspeed</groupId>
        <artifactId>jffast-starters</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jffast-starter-demo-mode</artifactId>
    <name>jffast-starter-demo-mode</name>
    <description>jffast Starter DemoMode - read-only demo site: block DB writes, file uploads and job triggers</description>

    <dependencies>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- MyBatis Executor 拦截（写短路） -->
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-mybatis</artifactId>
        </dependency>
        <!-- Quartz Scheduler 类型（暂停调度 + 拦截手动触发） -->
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-job</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
