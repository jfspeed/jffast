<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.jfspeed</groupId>
        <artifactId>jffast-biz</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jffast-system</artifactId>
    <name>jffast-system</name>
    <description>jffast System - Built-in system management (user, role, menu, dict, etc.)</description>

    <dependencies>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-log</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-file</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-excel</artifactId>
        </dependency>
        <!-- 通知邮件通道（SMTP）；不配置 spring.mail.* 时自动无 Bean，通道保持关闭 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-job</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.jfspeed</groupId>
            <artifactId>jffast-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <!--
          登录滑块验证码（行为验证）：仅引入 core 库，不用 springboot-starter。
          原因：starter 基于 Spring Boot 2.2 的 spring.factories 自动配置，
          在 Spring Boot 4 不再生效；core 库为纯 Java（仅 lombok/slf4j），
          由 CaptchaConfig 用 TACBuilder 手动装配，前后端 SDK 版本需一致（1.5.5）。
          许可证 MulanPSL2（宽松），通过依赖引入，不复制源码。
        -->
        <dependency>
            <groupId>cloud.tianai.captcha</groupId>
            <artifactId>tianai-captcha</artifactId>
            <version>1.5.5</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
