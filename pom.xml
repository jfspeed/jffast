<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.jfspeed</groupId>
    <artifactId>jffast</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>jffast</name>
    <description>jffast: A pluggable rapid development framework based on Spring Boot</description>
    <url>https://github.com/jfspeed/jffast</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>jffast</id>
            <name>jffast Team</name>
            <url>https://github.com/jfspeed</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/jfspeed/jffast</url>
        <connection>scm:git:git://github.com/jfspeed/jffast.git</connection>
        <developerConnection>scm:git:ssh://github.com/jfspeed/jffast.git</developerConnection>
    </scm>

    <modules>
        <module>jffast-bom</module>
        <module>jffast-common</module>
        <module>jffast-starters</module>
        <module>jffast-biz</module>
        <module>jffast-boot</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Spring Boot 4.1 线：要求 Java 17+，兼容至 Java 26；本项目 JDK 21 属推荐区间 -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <!--
          第三方依赖版本统一由 jffast-bom 管理（下方 dependencyManagement 导入），
          此处不再重复声明 mybatis-plus / sa-token / springdoc / hutool / yitter / fastexcel /
          minio / resilience4j / okhttp / bouncycastle / dom4j 的版本属性：
          根属性与 BOM 硬编码并存会形成「双真相源」，升级只改一处即静默漂移。
          升级这些依赖请直接改 jffast-bom。
        -->
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok.version>1.18.48</lombok.version>

        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-enforcer-plugin.version>3.6.2</maven-enforcer-plugin.version>
        <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
        <archunit.version>1.3.0</archunit.version>
        <!--
          覆盖率门禁（构建闸门）：jacoco:check 的最小行覆盖率，当前 0.10，
          随 Service 层测试补齐逐步上调，改代码只升不降。
          与 docs/开发规范.md §11「新增/修改代码行覆盖率 ≥ 80%」不冲突：
          前者卡整条 CI 流水线，后者是针对每次提交的质量要求。
        -->
        <jacoco.line.minimum>0.10</jacoco.line.minimum>
        <!--
          skipTests 显式声明为属性，供 jacoco:check 的 <skip> 引用：
          带 -DskipTests 的构建（本地快速迭代常用）不跑测试、无覆盖率数据，
          check 必须随之跳过，否则 verify 阶段必败（0% < 10% 门槛）。
          不带 -DskipTests 的常规构建（CI / mvn install）门禁照常生效。
        -->
        <skipTests>false</skipTests>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>cn.jfspeed</groupId>
                <artifactId>jffast-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>${maven-source-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar-no-fork</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven-javadoc-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>ban-split-dependency-families</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>enforce</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <!--
                                      把「依赖族只升一半」从运行期故障（NoClassDefFoundError，
                                      构建期完全无告警）变成构建期失败。

                                      背景：2026-11-02 后端起不来，根因是 BOM 把 MyBatis-Plus
                                      这一族 6 个坐标里的 3 个升到 3.5.18.1、另 3 个留在 3.5.16。
                                      Maven 的 dependencyManagement 覆盖传递依赖版本是**静默**的，
                                      构建 / 单测 / CI 全绿；而 3.5.17 上游把类挪了包
                                      （extension.service -> spring.service 等），
                                      自动配置类按新包名编译，类路径上却只有旧包名的 jar。

                                      requireUpperBoundDeps 管的正是「解析到的版本低于某个父构件
                                      所要求的版本」这一类静默降级。

                                      excludes 里几项是**已知且无害**的传递降级：都是单个 jar 被
                                      降级，不是一族坐标的分裂，上游也没有同名包迁移，所以不会
                                      长成 2026-11-02 那种「类挪了包」的形状：

                                        - com.fasterxml.jackson.*：Spring Boot 4 用 Jackson 3
                                          （tools.jackson），swagger-core 仍要 Jackson 2；
                                          由 Spring Boot 的 BOM 统一管理，版本差异是生态现状
                                        - commons-io：POI 经 easyexcel 要 2.21.0，
                                          Spring Boot 的 BOM 统一管理成 2.16.1
                                        - error_prone_annotations：gson/guava 要 2.41.0，
                                          被降成 2.36.0（纯注解 jar，无运行时语义）

                                      ⚠️ 新增 exclude 前请先确认它不是「一族坐标分裂」或
                                      「一方要新版、另一方钉旧版」——那两类必须**修 BOM**，
                                      不能排除（okhttp 与 commons-compress 就是这样被查出来
                                      并修掉的：一个被钉在 4.12.0 而 minio 要 5.1.0，
                                      大版本降级；另一个被钉在 1.27.1 而 minio 要 1.28.0）。

                                      附带作用：这条规则也把「BOM 钉的版本比依赖方要求的旧」
                                      这类静默降级暴露出来——2026-11-02 的审计就是靠它
                                      查出 okhttp 的陈旧钉子。
                                    -->
                                    <requireUpperBoundDeps>
                                        <excludes>
                                            <exclude>commons-io:commons-io</exclude>
                                            <exclude>com.google.errorprone:error_prone_annotations</exclude>
                                            <exclude>com.fasterxml.jackson.core:jackson-annotations</exclude>
                                            <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                                            <exclude>com.fasterxml.jackson.dataformat:jackson-dataformat-yaml</exclude>
                                            <exclude>com.fasterxml.jackson.datatype:jackson-datatype-jsr310</exclude>
                                        </excludes>
                                    </requireUpperBoundDeps>
                                </rules>
                                <fail>true</fail>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <skip>${skipTests}</skip>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.line.minimum}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                      Maven Central Portal 发布插件（替代已下线的 OSSRH s01.oss.sonatype.org）。
                      发布命令：mvn -Prelease deploy，凭据在 settings.xml 的 <server id="central">
                      配置 CENTRAL_TOKEN_USERNAME / CENTRAL_TOKEN_PASSWORD（Central 门户申请的用户令牌）。
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>github</id>
            <distributionManagement>
                <repository>
                    <id>github</id>
                    <url>https://maven.pkg.github.com/jfspeed/jffast</url>
                </repository>
                <snapshotRepository>
                    <id>github</id>
                    <url>https://maven.pkg.github.com/jfspeed/jffast</url>
                </snapshotRepository>
            </distributionManagement>
        </profile>
    </profiles>

</project>
